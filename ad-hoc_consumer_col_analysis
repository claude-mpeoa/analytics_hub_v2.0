                            </div>
                            <div class="bg-white/10 backdrop-blur-md p-5 rounded-2xl border border-white/10">
                                <h4 class="font-bold mb-2 flex items-center text-sm"><i data-lucide="zap" class="mr-2 w-4 h-4"></i> Solar Hedge</h4>
