                <div class="absolute top-3 right-3 bg-red-500 text-white text-[9px] font-black uppercase px-2 py-0.5 rounded-full tracking-widest">New</div>
                <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 bg-yellow-100 text-yellow-600">
                    <i data-lucide="zap"></i>
                </div>
                <h3 class="text-slate-500 text-sm font-medium mb-1">Eskom Tariff Hike</h3>
                <div class="text-2xl font-bold text-slate-900 mb-2">+8.76%</div>
                <p class="text-slate-400 text-xs mt-auto italic">Effective April 1. Municipalities: +9.01% from July 1.</p>
            </div>
        </section>

        <!-- Macro Trigger Row -->
