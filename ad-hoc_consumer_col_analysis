                            <div class="flex items-start space-x-4">
                                <div class="bg-yellow-50 p-2 rounded-lg text-yellow-600 mt-1 shrink-0">
                                    <i data-lucide="zap" class="w-5 h-5"></i>
                                </div>
                                <div>
                                    <h4 class="font-bold">The Electricity Multiplier</h4>
                                    <p class="text-sm text-slate-500">The 8.76% hike will turbocharge inflation — goods produced via grid electricity absorb the cost immediately.</p>
                                </div>
                            </div>
                        </div>
                        <div class="bg-slate-900 text-white p-6 rounded-2xl relative overflow-hidden">
                            <div class="relative z-10 h-full flex flex-col">
                                <div class="flex items-center space-x-2 text-yellow-400 mb-2">
                                    <i data-lucide="zap" class="w-4.5 h-4.5"></i>
                                    <span class="text-xs font-bold uppercase">The Generator Tax</span>
                                </div>
                                <div class="text-3xl font-bold mb-1">+R140<span class="text-lg font-normal text-slate-400">/hr</span></div>
                                <p class="text-sm text-slate-400 leading-snug">Extra fuel cost for standard 20L/hr generators during grid outages.</p>
                                <div class="mt-auto pt-4 border-t border-white/10">
                                    <div class="text-[10px] text-slate-400 italic">LPG tracks slower than diesel but remains highly sensitive to parity.</div>
                                </div>
                            </div>
                            <div class="absolute bottom-[-20px] right-[-10px] opacity-10 pointer-events-none">
                                <i data-lucide="zap" style="width: 120px; height: 120px;"></i>
                            </div>
                        </div>
                    </div>
