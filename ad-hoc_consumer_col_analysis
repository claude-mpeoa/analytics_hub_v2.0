            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 relative">
                <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-slate-100"></div>
                
                <div class="relative text-center md:text-right md:pr-12">
